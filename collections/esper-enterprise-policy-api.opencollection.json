            "name": "List all policies in enterprise",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/policy/",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "ID of the enterprise"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "filter by policy name"
              },
              {
                "name": "is_active",
                "value": "",
                "type": "query",
                "description": "filter by Active policies"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ]
          },
          "docs": "Returns Policies list"
        },
        {
