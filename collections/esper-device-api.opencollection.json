{
  "opencollection": "1.0.0",
  "info": {
    "name": "ESPER API REFERENCE Application Device API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Device",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch all devices in an enterprise",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/device/",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "ID of the enterprise"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by device name"
              },
              {
                "name": "group",
                "value": "",
                "type": "query",
                "description": "Filter by group id"
              },
              {
                "name": "imei",
                "value": "",
                "type": "query",
                "description": "filter by imei"
              },
              {
                "name": "serial",
                "value": "",
                "type": "query",
                "description": "filter by serial number"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "filter by device state"
              },
              {
                "name": "brand",
                "value": "",
                "type": "query",
                "description": "filter by brand"
              },
              {
                "name": "is_gms",
                "value": "",
                "type": "query",
                "description": "filter for gms devices"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "A search term. Search by device name, imei or mac address"
              },
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "A partial text search for device tags"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ]
          },
          "docs": "Returns a list of devices"
        },
        {
          "info": {
            "name": "Fetch device details by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/device/:device_id/",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "ID of the enterprise"
              },
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "ID of the device"
              }
            ]
          },
          "docs": "Returns details of a device"
        },
        {
          "info": {
            "name": "List all device apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/device/:device_id/app/",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this enterprise."
              },
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying device."
              },
              {
                "name": "package_name",
                "value": "",
                "type": "query",
                "description": "Filter by Package name"
              },
              {
                "name": "whitelisted",
                "value": "",
                "type": "query",
                "description": "Whitelist filter"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "A search term. Search by app_name."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ]
          },
          "docs": "Returns DeviceApp list"
        },
        {
          "info": {
            "name": "Get device app details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/device/:device_id/app/:app_id/",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this device app."
              },
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this device."
              },
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this enteprise."
              }
            ]
          },
          "docs": "Returns DeviceApp instance"
        },
        {
          "info": {
            "name": "List installed apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/device/:device_id/install/",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this enterprise."
              },
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying device."
              },
              {
                "name": "device",
                "value": "",
                "type": "query",
                "description": "filter by device id"
              },
              {
                "name": "package_name",
                "value": "",
                "type": "query",
                "description": "filter by package name"
              },
              {
                "name": "application_name",
                "value": "",
                "type": "query",
                "description": "filter by application name"
              },
              {
                "name": "install_state",
                "value": "",
                "type": "query",
                "description": "filter by install state"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ]
          },
          "docs": "Returns AppInstall list"
        },
        {
          "info": {
            "name": "Get latest device event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/enterprise/:enterprise_id/device/:device_id/status/",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this enterprise."
              },
              {
                "name": "device_id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying device."
              },
              {
                "name": "latest_event",
                "value": "",
                "type": "query",
                "description": "Flag to get latest event"
              }
            ]
          },
          "docs": "Returns DeviceStatus instance"
        }
      ]
    }
  ],
  "bundled": true
}